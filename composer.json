{
    "name": "avia-avian/laravel-dremio-odbc",
    "description": "Laravel driver for Dremio via ODBC or REST API.",
    "keywords": [
        "laravel",
        "odbc",
        "api",
        "dremio",
        "database"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Software Engineer Team",
            "email": "it_7@avianbrands.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/database": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/http": "^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "suggest": {
        "ext-odbc": "Required for ODBC connection mode"
    },
    "autoload": {
        "psr-4": {
            "AviaAvian\\DremioOdbc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AviaAvian\\DremioOdbc\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AviaAvian\\DremioOdbc\\Providers\\OdbcServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^9.0"
    }
}
